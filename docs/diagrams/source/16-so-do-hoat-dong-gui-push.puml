@startuml
title Hoạt động gửi push nhắc thuốc
skinparam shadowing false

start
:Cron chạy mỗi phút;
:transitionOverdueAndMissed();
note right
  pending quá 15 phút -> overdue
  pending/snoozed/overdue quá 30 phút -> missed
end note
:processDueNotifications();
:Tìm dose đến hạn / snoozed / overdue /\nmissed mới chuyển (lưới an toàn người thân) /\ncảnh báo người thân / hỏi thăm;
while (Còn dose cần xử lý?) is (có)
  :Chọn payload\nscheduled_reminder / snooze / overdue /\nrelative_alert / wellness_check;
  :Tìm Device active +\nnotifications_enabled=true;
  if (Có token?) then (không)
    :Ghi NotificationLog failed\n(no_active_device);
  else (có)
    :Gửi push tối đa 3 lần\n(backoff 1s / 5s / 15s);
    :Đánh dấu Device.status=invalid\nnếu token không còn hợp lệ;
    :Ghi NotificationLog +\nNotificationHistory theo người nhận;
    :Thiết bị hiển thị banner / deep link;
  endif
endwhile (không)
stop
@enduml
