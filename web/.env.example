# API backend (dev: dùng proxy Vite nên để /api/v1 là đủ)
VITE_API_BASE_URL=/api/v1

# Firebase Web app config (Firebase Console → Project settings → Your apps → Web app)
# Để trống thì app vẫn chạy, chỉ chưa đăng nhập được (xem README)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID key cho Web Push (Cloud Messaging → Web Push certificates) — Giai đoạn 5
VITE_FIREBASE_VAPID_KEY=
