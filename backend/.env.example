# Môi trường
NODE_ENV=development
PORT=3000
TZ_DEFAULT=Asia/Ho_Chi_Minh

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/medreminder

# Firebase (Email/Mật khẩu — Spark plan; xem README)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Cách 2 (dễ hơn): đặt file JSON service account vào backend/ rồi điền tên file
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cron
ENABLE_CRON=true
DOSE_GENERATION_DAYS=7
# Số phút chưa xác nhận thì báo người thân (mặc định 15)
RELATIVE_ALERT_AFTER_MINUTES=15

# CORS
CORS_ORIGIN=*
